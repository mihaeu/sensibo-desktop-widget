<Window x:Class="SensiboWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensibo widget settings" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F6F8F8" Foreground="#222B29"
        FontFamily="Segoe UI" FontSize="13" Topmost="True">
  <StackPanel Margin="24">
    <TextBlock Text="Your room, at a glance." FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock Text="Connect your Sensibo account to show its readings." TextWrapping="Wrap" Margin="0,0,0,18" />
    <TextBlock Margin="0,0,0,8"><Hyperlink Click="OpenKeyPage">Create an API key on Sensibo’s website</Hyperlink></TextBlock>
    <Label Content="API key" Target="{Binding ElementName=KeyBox}" Padding="0,0,0,5" />
    <PasswordBox x:Name="KeyBox" Height="32" Padding="6" PasswordChanged="KeyChanged"
                 AutomationProperties.Name="Sensibo API key" />
    <TextBlock Text="Stored encrypted for your Windows account." FontSize="11" Foreground="#5C6964" Margin="0,5,0,12" />
    <Button x:Name="ConnectButton" Content="Connect and find devices" Height="32" Click="Connect" />
    <Label Content="Device" Target="{Binding ElementName=DeviceBox}" Padding="0" Margin="0,14,0,5" />
    <ComboBox x:Name="DeviceBox" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id"
              SelectionChanged="SelectionChanged" AutomationProperties.Name="Device" />
    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel>
        <Label Content="Appearance" Target="{Binding ElementName=ThemeBox}" Padding="0,0,0,5" />
        <ComboBox x:Name="ThemeBox" Height="30" AutomationProperties.Name="Appearance">
          <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Label Content="Size" Target="{Binding ElementName=SizeBox}" Padding="0,0,0,5" />
        <ComboBox x:Name="SizeBox" Height="30" AutomationProperties.Name="Widget size">
          <ComboBoxItem Content="Default · 240" Tag="240" /><ComboBoxItem Content="Medium · 272" Tag="272" />
          <ComboBoxItem Content="Large · 296" Tag="296" /><ComboBoxItem Content="Extra large · 320" Tag="320" />
        </ComboBox>
      </StackPanel>
    </Grid>
    <CheckBox x:Name="StartupBox" Content="Start when I sign in to Windows" Margin="0,18,0,0" />
    <TextBlock Text="Barcelona weather: outside and forecast every 15 minutes; sea hourly. Model estimates by Open-Meteo (CC BY 4.0)." TextWrapping="Wrap" FontSize="11" Foreground="#5C6964" Margin="0,12,0,0" />
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="40" Margin="0,14,0,10" Foreground="#5C6964"
               AutomationProperties.LiveSetting="Polite" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="90" /><ColumnDefinition Width="10" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="Cancel" Height="32" IsCancel="True" />
      <Button x:Name="SaveButton" Grid.Column="3" Content="Save" Height="32" IsDefault="True" IsEnabled="False" Click="Save" />
    </Grid>
  </StackPanel>
</Window>
