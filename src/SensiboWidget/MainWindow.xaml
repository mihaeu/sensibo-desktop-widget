<Window x:Class="SensiboWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensibo widget" Width="240" Height="240" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" UseLayoutRounding="True" MouseLeftButtonDown="DragWidget"
        AutomationProperties.Name="Room readings and Barcelona weather">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#20272B" />
    <SolidColorBrush x:Key="Ink" Color="#EDF2EF" />
    <SolidColorBrush x:Key="MutedInk" Color="#A8B5AE" />
    <SolidColorBrush x:Key="Line" Color="#39464D" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="Emoji" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Segoe UI Emoji" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </Window.Resources>
  <Border x:Name="SurfaceBorder" CornerRadius="18" Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1" ToolTipService.InitialShowDelay="350">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Settings…" Click="OpenSettings" />
        <MenuItem Header="Reconnect" Click="Reconnect" />
        <MenuItem Header="Weather data: Open-Meteo…" Click="OpenWeatherSource" />
        <MenuItem Header="Move to main display" Click="ResetPosition" />
        <Separator />
        <MenuItem Header="Hide widget" Click="HideWidget" />
        <MenuItem Header="Quit" Click="Quit" />
      </ContextMenu>
    </Border.ContextMenu>
    <Viewbox Stretch="Uniform">
      <Grid Width="238" Height="238">
        <Grid x:Name="ReadingsGrid" Margin="13">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="TemperatureRow">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="99" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Room" Style="{StaticResource Label}" />
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TemperatureText" Text="—" FontSize="37" FontWeight="Medium" AutomationProperties.Name="Room temperature in Celsius" />
                <TextBlock Text="°C" FontSize="18" VerticalAlignment="Bottom" Margin="2,0,0,5" />
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="9,0,0,0" VerticalAlignment="Center">
              <StackPanel>
                <Grid x:Name="OutsidePanel" Background="Transparent" Margin="0,0,0,9">
                  <TextBlock Text="Outside" Style="{StaticResource Label}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="OutsideText" Text="—" Style="{StaticResource Value}" AutomationProperties.Name="Outside temperature in Celsius" />
                    <TextBlock Text="°C" FontSize="11" Margin="1,0,0,0" />
                  </StackPanel>
                </Grid>
                <Grid x:Name="SeaPanel" Background="Transparent">
                  <TextBlock Text="Sea" Style="{StaticResource Label}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SeaText" Text="—" Style="{StaticResource Value}" AutomationProperties.Name="Sea surface temperature in Celsius" />
                    <TextBlock Text="°C" FontSize="11" Margin="1,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="1" Height="1" VerticalAlignment="Center" Background="{DynamicResource Line}" />
            <UniformGrid x:Name="AirRow" Grid.Row="2" Columns="3">
              <StackPanel><TextBlock Text="Humidity" Style="{StaticResource Label}" /><StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource Value}" /><TextBlock Text="%" Style="{StaticResource Label}" Margin="2,0,0,0" />
              </StackPanel></StackPanel>
              <StackPanel><TextBlock Text="TVOC" Style="{StaticResource Label}" /><StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TvocText" Text="—" Style="{StaticResource Value}" /><TextBlock Text="ppb" Style="{StaticResource Label}" Margin="2,0,0,0" />
              </StackPanel></StackPanel>
              <StackPanel><TextBlock Text="eCO₂" Style="{StaticResource Label}" /><StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Co2Text" Text="—" Style="{StaticResource Value}" /><TextBlock Text="ppm" Style="{StaticResource Label}" Margin="2,0,0,0" />
              </StackPanel></StackPanel>
            </UniformGrid>
          <Border Grid.Row="3" Height="1" VerticalAlignment="Center" Background="{DynamicResource Line}" />
            <UniformGrid x:Name="ForecastRow" Grid.Row="4" Columns="3">
              <StackPanel x:Name="MorningPanel" Background="Transparent" VerticalAlignment="Center">
                <TextBlock Text="Morning" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                  <TextBlock x:Name="MorningIcon" Text="—" Style="{StaticResource Emoji}" /><TextBlock x:Name="MorningText" Text="—" FontSize="17" /><TextBlock Text="°C" FontSize="11" Margin="1,0,0,0" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="NoonPanel" Background="Transparent" VerticalAlignment="Center">
                <TextBlock Text="Noon" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                  <TextBlock x:Name="NoonIcon" Text="—" Style="{StaticResource Emoji}" /><TextBlock x:Name="NoonText" Text="—" FontSize="17" /><TextBlock Text="°C" FontSize="11" Margin="1,0,0,0" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="NightPanel" Background="Transparent" VerticalAlignment="Center">
                <TextBlock Text="Night" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                  <TextBlock x:Name="NightIcon" Text="—" Style="{StaticResource Emoji}" /><TextBlock x:Name="NightText" Text="—" FontSize="17" /><TextBlock Text="°C" FontSize="11" Margin="1,0,0,0" />
                </StackPanel>
              </StackPanel>
            </UniformGrid>
        </Grid>
        <Ellipse x:Name="StatusDot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,8,0" Fill="#C89750" Visibility="Collapsed" />
      </Grid>
    </Viewbox>
  </Border>
</Window>
