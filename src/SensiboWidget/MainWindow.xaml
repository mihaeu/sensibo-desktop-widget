<Window x:Class="SensiboWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensibo widget" Width="176" Height="176" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" UseLayoutRounding="True" MouseLeftButtonDown="DragWidget"
        AutomationProperties.Name="Sensibo air readings">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#20272B" />
    <SolidColorBrush x:Key="Ink" Color="#EDF2EF" />
    <SolidColorBrush x:Key="MutedInk" Color="#A8B5AE" />
    <SolidColorBrush x:Key="Line" Color="#39464D" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
    </Style>
  </Window.Resources>
  <Border x:Name="SurfaceBorder" CornerRadius="18" Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1" ToolTipService.InitialShowDelay="350">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Settings…" Click="OpenSettings" />
        <MenuItem Header="Reconnect" Click="Reconnect" />
        <MenuItem Header="Move to main display" Click="ResetPosition" />
        <Separator />
        <MenuItem Header="Hide widget" Click="HideWidget" />
        <MenuItem Header="Quit" Click="Quit" />
      </ContextMenu>
    </Border.ContextMenu>
    <Viewbox Stretch="Uniform">
      <Grid Width="174" Height="174" Margin="0">
        <Grid Margin="15,12,15,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="58" /><RowDefinition Height="1" />
            <RowDefinition Height="31" /><RowDefinition Height="30" /><RowDefinition Height="30" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Temp" Style="{StaticResource Label}" />
              <TextBlock Text="°C" Style="{StaticResource Label}" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock x:Name="TemperatureText" Text="—" FontSize="37" FontWeight="Medium"
                       HorizontalAlignment="Right" AutomationProperties.Name="Temperature in Celsius" />
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource Line}" />
          <Grid Grid.Row="2">
            <TextBlock Text="Humidity" Style="{StaticResource Label}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="HumidityText" Text="—" FontSize="21" FontWeight="Medium" />
              <TextBlock Text="%" Style="{StaticResource Label}" Margin="3,0,0,0" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3">
            <TextBlock Text="TVOC" Style="{StaticResource Label}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="TvocText" Text="—" FontSize="21" FontWeight="Medium" />
              <TextBlock Text="ppb" Style="{StaticResource Label}" Margin="3,0,0,0" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="4">
            <TextBlock Text="eCO₂" Style="{StaticResource Label}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="Co2Text" Text="—" FontSize="21" FontWeight="Medium" />
              <TextBlock Text="ppm" Style="{StaticResource Label}" Margin="3,0,0,0" />
            </StackPanel>
          </Grid>
        </Grid>
        <Ellipse x:Name="StatusDot" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,7,8,0" Fill="#C89750" Visibility="Collapsed" />
      </Grid>
    </Viewbox>
  </Border>
</Window>
